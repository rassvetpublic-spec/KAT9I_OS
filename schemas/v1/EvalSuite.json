{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/EvalSuite.json",
  "title": "EvalSuite",
  "description": "Машинный контракт оценочного набора (EvalSuite) и сценариев (EvalCase) для систематической оценки качества и регрессионного анализа агентного поведения в KAT9I_OS.",
  "type": "object",
  "version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "domain",
    "rules_ref",
    "version",
    "cases",
    "created_at"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^eval-suite-[a-zA-Z0-9_-]{3,64}$",
      "description": "Уникальный идентификатор оценочного набора."
    },
    "domain": {
      "type": "string",
      "description": "Доменная область сценариев (software_engineering, architecture, security, qa)."
    },
    "rules_ref": {
      "type": "string",
      "description": "Идентификатор и версия действующих канонических правил."
    },
    "version": {
      "type": "string",
      "description": "Версия набора сценариев (SemVer)."
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Текстовое описание целей тестирования в наборе."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "name",
          "input",
          "expected_invariants",
          "forbidden_actions"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^case-[a-zA-Z0-9_-]{3,64}$",
            "description": "Идентификатор тестового сценария."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Название сценария."
          },
          "input": {
            "type": "object",
            "description": "Входные данные для сценария (текст issue, файл, окружение)."
          },
          "context_fixtures": {
            "type": "object",
            "default": {},
            "description": "Зафиксированный тестовый контекст (файлы, переменные)."
          },
          "expected_invariants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Список обязательных детерминированных инвариантов (например, 'status=PASS', 'no_direct_main_commit')."
          },
          "forbidden_actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Список категорически запрещенных действий (например, 'DIRECT_PUSH_MAIN', 'SELF_QA_APPROVAL')."
          },
          "scoring_criteria": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "default": {},
            "description": "Веса критериев оценки (от 0.0 до 1.0)."
          }
        }
      },
      "description": "Список сценариев оценки (EvalCase)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Временная метка создания набора в ISO 8601."
    }
  }
}
