{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/GraveyardCandidate.json",
  "title": "GraveyardCandidate",
  "description": "Неисполняемый кандидат на ручное возвращение идеи из Graveyard в обычный рабочий процесс.",
  "type": "object",
  "version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source_ref",
    "archive_id",
    "resurrected_from",
    "idea_summary",
    "canon_check",
    "state",
    "actionable",
    "control",
    "requires_owner_confirmation",
    "activation_ref",
    "owner_confirmation_ref",
    "created_at"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^gyc-[a-f0-9]{16}$"},
    "source_ref": {
      "type": "string",
      "pattern": "^ctx-[a-zA-Z0-9_-]{8,160}$",
      "description": "ContextRef исходной Graveyard-записи."
    },
    "archive_id": {"type": "string", "pattern": "^GY-[a-zA-Z0-9._-]{3,120}$"},
    "resurrected_from": {
      "type": "string",
      "pattern": "^GY-[a-zA-Z0-9._-]{3,120}$",
      "description": "Provenance Archive ID Graveyard."
    },
    "selector": {"type": "string", "default": ""},
    "idea_summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "canon_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_revision", "evidence_ref", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NOT_CHECKED", "COMPATIBLE", "CONFLICT", "SUPERSEDED", "UNKNOWN"]
        },
        "checked_revision": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]},
        "notes": {"type": "string", "maxLength": 4096}
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "AWAITING_OWNER_CONFIRMATION",
        "BLOCKED_BY_CANON",
        "APPROVED_FOR_NORMAL_WORKFLOW",
        "REJECTED"
      ]
    },
    "actionable": {"const": false},
    "control": {"const": false},
    "requires_owner_confirmation": {"const": true},
    "activation_ref": {"type": ["string", "null"]},
    "owner_confirmation_ref": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "canon_check": {
            "properties": {"status": {"const": "NOT_CHECKED"}},
            "required": ["status"]
          }
        },
        "required": ["canon_check"]
      },
      "then": {
        "properties": {
          "canon_check": {
            "properties": {"checked_revision": {"type": "null"}}
          }
        }
      },
      "else": {
        "properties": {
          "canon_check": {
            "properties": {"checked_revision": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "CANDIDATE"}}, "required": ["state"]},
      "then": {
        "properties": {
          "canon_check": {"properties": {"status": {"const": "NOT_CHECKED"}}},
          "activation_ref": {"type": "null"},
          "owner_confirmation_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "AWAITING_OWNER_CONFIRMATION"}}, "required": ["state"]},
      "then": {
        "properties": {
          "canon_check": {"properties": {"status": {"const": "COMPATIBLE"}}},
          "activation_ref": {"type": "null"},
          "owner_confirmation_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "APPROVED_FOR_NORMAL_WORKFLOW"}}, "required": ["state"]},
      "then": {
        "properties": {
          "canon_check": {"properties": {"status": {"const": "COMPATIBLE"}}},
          "activation_ref": {"type": "string", "pattern": "^gya-[a-f0-9]{16}$"},
          "owner_confirmation_ref": {"type": "string", "pattern": "^appr-[a-zA-Z0-9_-]{8,64}$"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "BLOCKED_BY_CANON"}}, "required": ["state"]},
      "then": {
        "properties": {
          "canon_check": {"properties": {"status": {"enum": ["CONFLICT", "SUPERSEDED", "UNKNOWN"]}}},
          "activation_ref": {"type": "null"},
          "owner_confirmation_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "REJECTED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "activation_ref": {"type": "null"},
          "owner_confirmation_ref": {"type": "null"}
        }
      }
    }
  ]
}
