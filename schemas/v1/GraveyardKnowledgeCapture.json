{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/GraveyardKnowledgeCapture.json",
  "title": "GraveyardKnowledgeCapture",
  "description": "Структурированный DATA-only снимок накопленных знаний из обсуждения/исследования. Захват разрешён автоматически без подтверждения владельца; любое последующее повышение в CONTROL требует отдельного Human Approval. Основной язык — русский; английские технические термины получают русские пояснения автоматически.",
  "type": "object",
  "version": "1.1.0",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source_type",
    "source_label",
    "captured_at",
    "canon_revision",
    "title",
    "summary",
    "knowledge_items",
    "public_safe",
    "raw_chat_included",
    "actionable",
    "control",
    "canonical",
    "requires_owner_confirmation",
    "promotion_requires_owner_approval"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "project": {"type": "string", "const": "KAT9I_OS"},
    "source_type": {
      "type": "string",
      "enum": ["TZ_DISCUSSION", "CHAT", "RESEARCH", "REVIEW", "WORK_SESSION", "OTHER"]
    },
    "source_label": {"type": "string", "minLength": 1, "maxLength": 200},
    "captured_at": {"type": "string", "format": "date-time"},
    "canon_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "summary": {"type": "string", "minLength": 10, "maxLength": 10000},
    "term_explanations": {
      "type": "object",
      "description": "Автоматически подготовленные русские пояснения для английских технических терминов, которых ещё нет во встроенном словаре Graveyard.",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "minLength": 2,
        "maxLength": 300,
        "pattern": "[А-Яа-яЁё]"
      }
    },
    "knowledge_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["FACT", "RATIONALE", "DECISION_CONTEXT", "REJECTED_OPTION", "IDEA", "QUESTION", "RISK", "OBSERVATION"]
          },
          "text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "canon_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "public_safe": {"const": true},
    "raw_chat_included": {"const": false},
    "actionable": {"const": false},
    "control": {"const": false},
    "canonical": {"const": false},
    "requires_owner_confirmation": {"const": false},
    "promotion_requires_owner_approval": {"const": true}
  }
}
