{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/ModuleRegistry.json",
  "title": "ModuleRegistry",
  "description": "Каноническая машинная схема реестра модулей и графа зависимостей KAT9I_OS.",
  "type": "object",
  "version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "updated_at",
    "modules"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Версия спецификации реестра модулей по стандарту SemVer."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Временная метка последней синхронизации реестра в формате ISO 8601."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "description": "Список зарегистрированных модулей системы.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "name",
          "version",
          "tier",
          "canonical_owner_ref",
          "canonical_responsibility",
          "provides_contracts",
          "requires_contracts",
          "dependencies",
          "capabilities",
          "health_interface",
          "documentation_ref"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{3,32}$",
            "description": "Уникальный идентификатор модуля."
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "description": "Человекочитаемое название модуля."
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Версия реализации модуля (SemVer)."
          },
          "tier": {
            "type": "string",
            "enum": [
              "CORE_RUNTIME",
              "SECURITY_CONTROL",
              "STORAGE_AUDIT",
              "EXECUTION_WORKER",
              "DESKTOP_UI"
            ],
            "description": "Архитектурный уровень (ярус) модуля."
          },
          "canonical_owner_ref": {
            "type": "string",
            "description": "Ссылка на канонический пункт в карте ответственности (docs/architecture/27_MODULE_REGISTRY_AND_RESPONSIBILITY_MAP.md)."
          },
          "canonical_responsibility": {
            "type": "string",
            "minLength": 5,
            "description": "Формулировка уникальной канонической ответственности модуля (инвариант ADR-032)."
          },
          "provides_contracts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Список контрактов/схем, создаваемых или предоставляемых данным модулем."
          },
          "requires_contracts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Список контрактов/схем, требуемых модулю для штатной работы."
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Список module_id модулей, необходимых для инициализации и работы данного модуля."
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Предоставляемые системные возможности."
          },
          "health_interface": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "endpoint"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["INTERNAL_STATE_PROBE", "IPC_PING", "FILE_WATCHER", "IN_PROCESS"]
              },
              "endpoint": {
                "type": "string",
                "description": "Имя интерфейса или метода опроса работоспособности."
              }
            }
          },
          "documentation_ref": {
            "type": "string",
            "description": "Относительный путь к канонической архитектурной документации модуля."
          }
        }
      }
    }
  }
}
