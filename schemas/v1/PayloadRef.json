{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/PayloadRef.json",
  "title": "PayloadRef",
  "description": "Машинный контракт ссылки на материализованные данные полезной нагрузки (PayloadRef) CacheEngine KAT9I_OS.",
  "type": "object",
  "version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "payload_id",
    "storage_mode",
    "byte_size",
    "checksum",
    "checksum_algorithm",
    "created_at"
  ],
  "properties": {
    "payload_id": {
      "type": "string",
      "pattern": "^pay-[a-zA-Z0-9_-]{8,64}$",
      "description": "Уникальный системный идентификатор полезной нагрузки."
    },
    "storage_mode": {
      "type": "string",
      "enum": [
        "RAM_REGION",
        "SPILL_SEGMENT",
        "SHARED_MEMORY",
        "MMAP",
        "INLINE",
        "REMOTE_REF"
      ],
      "description": "Режим физического размещения и адресации данных согласно разделу 34.12."
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0,
      "description": "Размер полезной нагрузки в байтах."
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Авторитетная 256-битная контрольная сумма полезной нагрузки (ровно 64 hex-символа)."
    },
    "checksum_algorithm": {
      "type": "string",
      "enum": [
        "SHA-256",
        "BLAKE3"
      ],
      "description": "Явный криптографический алгоритм вычисления контрольной суммы полезной нагрузки."
    },
    "segment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(seg-[a-zA-Z0-9_-]{8,64})?$",
      "description": "Идентификатор неизменяемого сегмента при storage_mode=SPILL_SEGMENT или MMAP."
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Байтовое смещение внутри сегмента или файла при storage_mode=SPILL_SEGMENT или MMAP."
    },
    "mmap_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Путь к проецируемому файлу при storage_mode=MMAP."
    },
    "shm_handle": {
      "type": [
        "string",
        "null"
      ],
      "description": "Дескриптор или имя именованной разделяемой памяти (Windows Named Shared Memory) при storage_mode=SHARED_MEMORY."
    },
    "remote_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://\\S+$",
      "description": "Удалённый URI полезной нагрузки при storage_mode=REMOTE_REF."
    },
    "inline_data": {
      "type": [
        "string",
        "null"
      ],
      "description": "Встроенные строковые или base64-кодированные данные полезной нагрузки при storage_mode=INLINE."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Временная метка материализации полезной нагрузки в ISO 8601."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "INLINE"
          }
        }
      },
      "then": {
        "required": [
          "inline_data"
        ],
        "properties": {
          "inline_data": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "SPILL_SEGMENT"
          }
        }
      },
      "then": {
        "required": [
          "segment_id",
          "offset"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^seg-[a-zA-Z0-9_-]{8,64}$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "MMAP"
          }
        }
      },
      "then": {
        "required": [
          "offset"
        ],
        "oneOf": [
          {
            "required": [
              "mmap_path"
            ],
            "properties": {
              "mmap_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "segment_id"
            ],
            "properties": {
              "segment_id": {
                "type": "string",
                "pattern": "^seg-[a-zA-Z0-9_-]{8,64}$"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "SHARED_MEMORY"
          }
        }
      },
      "then": {
        "required": [
          "shm_handle"
        ],
        "properties": {
          "shm_handle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "REMOTE_REF"
          }
        }
      },
      "then": {
        "required": [
          "remote_uri"
        ],
        "properties": {
          "remote_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://\\S+$"
          }
        }
      }
    }
  ]
}
