{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kat9i.org/schemas/v1/RequirementsRegistry.json",
  "title": "KAT9I_OS Requirements Registry",
  "description": "Машинный контракт T0 Requirements Registry. Реестр хранит traceability и классификацию, но не дублирует содержание канонических SSoT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "baseline_revision",
    "generated_from",
    "source_inventory",
    "requirements",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "baseline_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_from": {
      "type": "string",
      "minLength": 1
    },
    "source_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "CANONICAL_SSoT",
              "MACHINE_CONTRACT",
              "RESPONSIBILITY_MAP",
              "GATE_ROADMAP",
              "CONTROL_PROCESS",
              "TRACEABILITY",
              "DERIVED"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    }
  },
  "$defs": {
    "refArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "title",
        "area",
        "type",
        "canonical_ssot",
        "canonical_owner",
        "target_gate",
        "target_version",
        "status",
        "dependencies",
        "machine_contract_refs",
        "evidence_refs",
        "issue_refs",
        "coverage_status",
        "abc",
        "xyz",
        "materialization"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9][A-Z0-9_-]*-[0-9]{3}$"
        },
        "title": {"type": "string", "minLength": 3},
        "area": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "ARCHITECTURE",
            "RESPONSIBILITY",
            "INVARIANT",
            "CONTRACT",
            "SECURITY",
            "QUALITY",
            "PROCESS",
            "INTEGRATION",
            "UX",
            "ASSUMPTION",
            "OPEN_QUESTION"
          ]
        },
        "canonical_ssot": {"type": "string", "minLength": 1},
        "canonical_owner": {"type": "string", "minLength": 1},
        "target_gate": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["ACCEPTED", "OPEN", "DEFERRED", "GAP", "BLOCKED"]
        },
        "dependencies": {"$ref": "#/$defs/refArray"},
        "machine_contract_refs": {"$ref": "#/$defs/refArray"},
        "evidence_refs": {"$ref": "#/$defs/refArray"},
        "issue_refs": {"$ref": "#/$defs/refArray"},
        "coverage_status": {
          "enum": [
            "COVERED",
            "GAP",
            "CONTRADICTION",
            "TRACEABILITY_GAP",
            "CONTRACT_GAP",
            "OWNER_GAP",
            "BLOCKED"
          ]
        },
        "coverage_notes": {"type": "string"},
        "abc": {"const": "UNASSESSED"},
        "xyz": {"const": "UNASSESSED"},
        "materialization": {
          "enum": ["MATERIALIZED", "LOGICAL_ONLY", "DERIVED", "NOT_APPLICABLE"]
        },
        "runtime_module_ref": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "kind", "title", "requirement_refs", "source_refs", "status"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^GAP-T0-[0-9]{3}$"},
        "kind": {
          "enum": ["GAP", "CONTRADICTION", "TRACEABILITY_GAP", "CONTRACT_GAP", "OWNER_GAP", "BLOCKED"]
        },
        "title": {"type": "string", "minLength": 3},
        "requirement_refs": {"$ref": "#/$defs/refArray"},
        "source_refs": {"$ref": "#/$defs/refArray"},
        "status": {"enum": ["OPEN", "DEFERRED", "BLOCKED"]},
        "notes": {"type": "string"}
      }
    }
  }
}
